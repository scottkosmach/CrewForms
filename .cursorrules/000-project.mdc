│   │   │   ├── server.ts       # Server client
│   │   │   └── middleware.ts   # Auth middleware helper
│   │   ├── validations/        # Zod schemas
│   │   └── utils.ts            # Utility functions
│   ├── hooks/                  # Custom React hooks
│   └── types/                  # TypeScript types
│
├── supabase/
