## Dark Mode

```typescript
// In layout.tsx, use ThemeProvider from next-themes
import { ThemeProvider } from '@/components/theme-provider'

export default function RootLayout({ children }) {
  return (
    <html lang="en" suppressHydrationWarning>
      <body>
        <ThemeProvider
          attribute="class"
          defaultTheme="system"
          enableSystem
          disableTransitionOnChange
        >
          {children}
        </ThemeProvider>
      </body>
    </html>
  )
}

// Toggle component
'use client'

import { useTheme } from 'next-themes'
import { Moon, Sun } from 'lucide-react'
import { Button } from '@/components/ui/button'

export function ThemeToggle() {
  const { theme, setTheme } = useTheme()

  return (
    <Button
      variant="ghost"
      size="icon"
      onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')}
    >
      <Sun className="h-4 w-4 rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0" />
      <Moon className="absolute h-4 w-4 rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100" />
    </Button>
  )
}
```


## Common Utility Classes

| Purpose | Classes |
|---------|---------|
| Spacing | `p-4`, `px-6`, `py-8`, `m-2`, `mx-auto`, `space-y-4`, `gap-4` |
| Flexbox | `flex`, `items-center`, `justify-between`, `flex-1`, `flex-col` |
| Grid | `grid`, `grid-cols-3`, `gap-6`, `col-span-2` |
| Text | `text-sm`, `text-lg`, `font-medium`, `font-bold`, `text-muted-foreground` |
| Colors | `bg-primary`, `text-primary`, `border-border`, `bg-muted` |
| Borders | `border`, `rounded-md`, `rounded-lg`, `border-b` |
| Shadows | `shadow-sm`, `shadow-md`, `shadow-lg` |
| Width | `w-full`, `max-w-md`, `min-w-0`, `w-[200px]` |


## Key Conventions

- **Use shadcn/ui components** - Don't rebuild common patterns
- **Utility-first** - Prefer Tailwind classes over custom CSS
- **CSS variables for theming** - Customize in globals.css
- **Mobile-first** - Start with mobile styles, add breakpoints
- **Consistent spacing** - Use Tailwind's spacing scale (4, 6, 8...)
- **Semantic colors** - Use `primary`, `muted`, `destructive` not raw colors
- **Icon sizing** - Standard is `h-4 w-4` in buttons, `h-5 w-5` standalone
